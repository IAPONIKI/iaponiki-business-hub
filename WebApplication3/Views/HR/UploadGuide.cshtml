@{
    ViewData["Title"] = "HTML Upload Guide";
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">How to Upload Generated HTML to the Website</h4>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <p><strong>Important:</strong> This guide will help you upload the HTML code you've generated to the company website.</p>
        </div>

        <h5 class="mt-4 mb-3">Step 1: Copy the Generated HTML</h5>
        <div class="row mb-4">
            <div class="col-md-6">
                <p>After generating your HR code in the system, click the "Download as .html" button or copy the code directly from the text area.</p>
            </div>
            <div class="col-md-6">
                <img src="/images/guide/copy-code.png" alt="Copy HTML Code" class="img-fluid border rounded shadow-sm">
            </div>
        </div>

        <h5 class="mt-4 mb-3">Step 2: Log into the Website CMS</h5>
        <div class="row mb-4">
            <div class="col-md-6">
                <ol>
                    <li>Go to <a href="https://iaponiki.gr/netvolution/Account/Login" target="_blank">https://iaponiki.gr/netvolution/Account/Login</a></li>
                    <li>Enter your username and password.</li>
                </ol>
            </div>
            <div class="col-md-6">
                <img src="/images/guide/cms-login.png" alt="CMS Login Screen" class="img-fluid border rounded shadow-sm">
            </div>
        </div>

        <h5 class="mt-4 mb-3">Step 3: Find the HR Page</h5>
        <div class="row mb-4">
            <div class="col-md-6">
                <ol>
                    <li>In the dashboard, click on "Content" > "Pages".</li>
                    <li>Find and click on "HR" > "Ανοιχτές Θέσεις".</li>
                    <li>In the Content container, find the menu item "Tools" > "Source Code".</li>
                </ol>
            </div>
            <div class="col-md-6">
                <img src="/images/guide/find-hr-page.png" alt="Finding HR Page" class="img-fluid border rounded shadow-sm">
            </div>
        </div>

        <h5 class="mt-4 mb-3">Step 4: Insert the HTML Code</h5>
        <div class="row mb-4">
            <div class="col-md-6">
                <ol>
                    <li>In the page editor, delete all content.</li>
                    <li>Paste your newly generated HTML code.</li>
                    <li>Click OK.</li>
                </ol>
            </div>
            <div class="col-md-6">
                <img src="/images/guide/paste-html.png" alt="Paste HTML Code" class="img-fluid border rounded shadow-sm">
            </div>
        </div>

        <h5 class="mt-4 mb-3">Step 5: Save and Publish</h5>
        <div class="row mb-4">
            <div class="col-md-6">
                <ol>
                    <li>Preview the page to make sure everything looks correct.</li>
                    <li>Click the "Save Record" button to save your changes and publish the page.</li>
                </ol>
            </div>
            <div class="col-md-6">
                <img src="/images/guide/save-publish.png" alt="Save and Publish" class="img-fluid border rounded shadow-sm">
            </div>
        </div>

