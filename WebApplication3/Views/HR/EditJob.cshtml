@model WebApplication3.Models.HRModel.JobPosting

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 fs-4"><i class="fas fa-edit me-2"></i>Edit Job</h2>
        </div>
        <div class="card-body">
            <form asp-action="EditJob" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Title</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-tag"></i></span>
                            <input type="text" asp-for="Title" class="form-control" required placeholder="Enter job title" />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-bold">Category</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-folder"></i></span>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select a category</option>
                                <option value="Development">Development</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Management">Management</option>
                                <option value="Sales">Sales</option>
                                <option value="Support">Support</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                </div>

                -
                <div class="col-mb-3">
                    <label asp-for="Location" class="form-label fw-bold">Location</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                        <input type="text" asp-for="Location" class="form-control" placeholder="Enter job location" />
                    </div>
                </div>
                -

                <div class="mb-3">
                    <label asp-for="Summary" class="form-label fw-bold">Summary</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                        <textarea asp-for="Summary" class="form-control" rows="2" required placeholder="Brief summary of the position"></textarea>
                    </div>
                    <div class="form-text">A short description that will appear in job listings</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Details" class="form-label fw-bold">Details</label>
                    <textarea asp-for="Details" class="form-control" rows="6" required placeholder="Detailed job description, requirements, benefits, etc."></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ApplyLink" class="form-label fw-bold">Apply Link</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-link"></i></span>
                            <input type="url" asp-for="ApplyLink" class="form-control" required placeholder="https://..." />
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="OrderId" class="form-label fw-bold">Display Order</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-sort-numeric-down"></i></span>
                            <input type="number" asp-for="OrderId" class="form-control" min="0" placeholder="0" />
                        </div>
                        <div class="form-text">Lower numbers appear first</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <div class="form-control bg-light d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch">
                                    <span id="statusLabel" class="ms-1"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PostingDate" class="form-label fw-bold">Posting Date</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-plus"></i></span>
                            <input type="date" asp-for="PostingDate" class="form-control" required />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label fw-bold">Expiry Date</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-times"></i></span>
                            <input type="date" asp-for="ExpiryDate" class="form-control" required />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between border-top pt-3 mt-3">
                    <a asp-action="ManageJobs" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Cancel
                    </a>
                    <div>
                        <button type="button" class="btn btn-danger me-2" data-bs-toggle="modal" data-bs-target="#deleteJobModal">
                            <i class="fas fa-trash-alt me-2"></i>Delete
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteJobModal" tabindex="-1" aria-labelledby="deleteJobModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteJobModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this job posting?</p>
                <p class="text-danger"><strong>This action cannot be undone.</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a asp-action="DeleteJob" asp-route-id="@Model.Id" class="btn btn-danger">Delete Job</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Update status text based on checkbox
            const isActiveSwitch = document.getElementById('isActiveSwitch');
            const statusLabel = document.getElementById('statusLabel');
            const jobStatus = document.getElementById('jobStatus');

            function updateStatus() {
                const isActive = isActiveSwitch.checked;
                statusLabel.textContent = isActive ? 'Active' : 'Inactive';
                statusLabel.className = isActive ? 'text-success' : 'text-danger';

                const today = new Date();
                const expiryDate = new Date(document.querySelector('input[asp-for="ExpiryDate"]').value);

                if (!isActive) {
                    jobStatus.innerHTML = '<span class="badge bg-danger">Inactive</span> This job will not be visible to applicants.';
                } else if (expiryDate < today) {
                    jobStatus.innerHTML = '<span class="badge bg-warning">Expired</span> This job has passed its expiry date but is still marked as active.';
                } else if (expiryDate <= new Date(today.getTime() + 7 * 24 * 60 * 60 * 1000)) {
                    jobStatus.innerHTML = '<span class="badge bg-warning">Expiring Soon</span> This job will expire within the next 7 days.';
                } else {
                    jobStatus.innerHTML = '<span class="badge bg-success">Active</span> This job is visible to applicants.';
                }
            }

            isActiveSwitch.addEventListener('change', updateStatus);
            document.querySelector('input[asp-for="ExpiryDate"]').addEventListener('change', updateStatus);

            // Initialize status on page load
            updateStatus();

            // Simple validation to ensure expiry date is after posting date
            document.querySelector('form').addEventListener('submit', function(e) {
                const postingDate = new Date(document.querySelector('input[asp-for="PostingDate"]').value);
                const expiryDate = new Date(document.querySelector('input[asp-for="ExpiryDate"]').value);

                if (expiryDate <= postingDate) {
                    e.preventDefault();
                    alert('Expiry date must be after posting date');
                }
            });
        });
    </script>
}