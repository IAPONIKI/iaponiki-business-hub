@model WebApplication3.Models.ViewComponents.NavigationViewModel

<ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="fas fa-home"></i> Home
        </a>
    </li>

    @if (Model.CanViewAdminMenu)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Admin" asp-action="AdminDashboard">
                <i class="fas fa-tachometer-alt"></i> Admin Dashboard
            </a>
        </li>
    }

    @if (Model.CanViewHRMenu)
    {
        <!-- HR menu -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" id="hrDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-briefcase"></i> HR
            </a>
            <ul class="dropdown-menu" aria-labelledby="hrDropdown">
                <li><a class="dropdown-item" asp-controller="HR" asp-action="ManageJobs">Manage Jobs</a></li>
                <li><a class="dropdown-item" asp-controller="HR" asp-action="ManageBaseHR">Manage HR Base</a></li>
                <li><a class="dropdown-item" asp-controller="HR" asp-action="AddJob">Add Jobs</a></li>
                @if (Model.IsAdmin)
                {
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="HR" asp-action="JobDashboard">HR Dashboard</a></li>
                }
            </ul>
        </li>
    }

    @if (Model.CanViewFinanceMenu)
    {
        <!-- Finance menu -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" id="invoiceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-file-invoice-dollar"></i> Invoices
            </a>
            <ul class="dropdown-menu" aria-labelledby="invoiceDropdown">
                <li><a class="dropdown-item" asp-controller="Invoice" asp-action="Dashboard">Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Invoice" asp-action="Index">Compare Invoices</a></li>
                <li><a class="dropdown-item" asp-controller="Invoice" asp-action="PendingPayments">Pending Payments</a></li>
            </ul>
        </li>
    }

    @if (Model.CanViewMarketingMenu)
    {
        <!-- Marketing menu -->
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Carousels" asp-action="Index">
                <i class="fas fa-images"></i> Marketing Content
            </a>
        </li>
    }

    @if (Model.CanManagePermissions)
    {
        <!-- Permission Management -->
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Permissions" asp-action="Index">
                <i class="fas fa-key"></i> Permissions
            </a>
        </li>
    }
</ul>