@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card bg-primary text-white mb-4 shadow">
                <div class="card-body">
                    <h2>
                        <i class="fas fa-tachometer-alt"></i> Administration Dashboard
                    </h2>
                    <p class="mb-0">Welcome to the administration panel. Here you can manage users, roles, permissions and system settings.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- User Management Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ManageUsers">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-primary">
                            <i class="fas fa-users text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">User Management</h3>
                    </div>
                    <p>Add, edit, or remove users from the system. Assign roles and permissions to users.</p>
                    <a asp-action="UserManagement" class="btn btn-primary mt-auto">
                        Manage Users <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Role Management Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ManageRoles">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-success">
                            <i class="fas fa-user-tag text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">Role Management</h3>
                    </div>
                    <p>Create and manage user roles. Define what each role represents in the system.</p>
                    <a asp-action="RoleManagement" class="btn btn-success mt-auto">
                        Manage Roles <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Permission Management Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ManagePermissions">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-info">
                            <i class="fas fa-key text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">Permission Management</h3>
                    </div>
                    <p>Configure what each role can access and view within the system. Fine-tune permissions for each role.</p>
                    <a asp-controller="Permissions" asp-action="Index" class="btn btn-info mt-auto">
                        Manage Permissions <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- HR Management Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ViewHRMenu">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-warning">
                            <i class="fas fa-briefcase text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">HR Management</h3>
                    </div>
                    <p>Manage job postings, HR content, and career opportunities for your organization.</p>
                    <a asp-controller="HR" asp-action="ManageJobs" class="btn btn-warning mt-auto">
                        Go to HR <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Invoice System Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ViewFinanceMenu">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-danger">
                            <i class="fas fa-file-invoice-dollar text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">Invoice System</h3>
                    </div>
                    <p>Manage invoices, payments, and financial records for your organization.</p>
                    <a asp-controller="Invoice" asp-action="Dashboard" class="btn btn-danger mt-auto">
                        Go to Invoices <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Marketing Content Card -->
        <div class="col-md-6 col-lg-4 mb-4" asp-permission="@Permissions.ViewMarketingMenu">
            <div class="card h-100 shadow hover-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-wrapper bg-secondary">
                            <i class="fas fa-ad text-white"></i>
                        </div>
                        <h3 class="ms-3 mb-0">Marketing Content</h3>
                    </div>
                    <p>Manage carousel images, product promotions, and marketing materials for your website.</p>
                    <a asp-controller="Carousels" asp-action="Index" class="btn btn-secondary mt-auto">
                        Go to Marketing <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .hover-card {
        transition: transform 0.3s ease;
    }

        .hover-card:hover {
            transform: translateY(-5px);
        }

    .card-body {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
</style>