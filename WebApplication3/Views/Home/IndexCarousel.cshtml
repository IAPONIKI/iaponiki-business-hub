@model WebApplication3.Models.CarouselModel

<div class="container mt-5">
    <h2 class="text-center mb-4">Which Carousels Do You Need?</h2>
    <form asp-action="ChooseCarousels" method="post" class="p-4 bg-light rounded shadow-sm">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" asp-for="NeedsSeminario" id="seminarioCheckbox">
            <label class="form-check-label" asp-for="NeedsSeminario" for="seminarioCheckbox">
                Σεμινάριο
            </label>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" asp-for="NeedsEnergeiesTouMina" id="energeiesCheckbox">
            <label class="form-check-label" asp-for="NeedsEnergeiesTouMina" for="energeiesCheckbox">
                Ενέργειες του Μήνα
            </label>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" asp-for="NeedsProsforesExoplismou" id="prosforesCheckbox">
            <label class="form-check-label" asp-for="NeedsProsforesExoplismou" for="prosforesCheckbox">
                Προσφορές Εξοπλισμού Συνεργείου
            </label>
        </div>
        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-primary px-5">Next</button>
        </div>
    </form>
</div>
