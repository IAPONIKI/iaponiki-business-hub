@model List<WebApplication3.Models.PendingInvoiceData>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-clock"></i> Pending Payments</h2>
            <div>
                <a asp-action="DownloadPendingInvoices" class="btn btn-success btn-sm">
                    <i class="fas fa-file-excel"></i> Export
                </a>
                <a asp-action="Dashboard" class="btn btn-info btn-sm">
                    <i class="fas fa-chart-pie"></i> Dashboard
                </a>
            </div>
        </div>
        <div class="card-body">
            <!-- Status Filter -->
            <div class="mb-4">
                <div class="btn-group" role="group">
                    <a asp-action="PendingPayments" asp-route-statusFilter="All"
                       class="btn @(ViewBag.StatusFilter == "All" ? "btn-primary" : "btn-outline-primary")">
                        All (@Model.Count)
                    </a>
                    <a asp-action="PendingPayments" asp-route-statusFilter="Pending"
                       class="btn @(ViewBag.StatusFilter == "Pending" ? "btn-primary" : "btn-outline-primary")">
                        Pending (@Model.Count(i => i.Status == "Pending"))
                    </a>
                    <a asp-action="PendingPayments" asp-route-statusFilter="Matched"
                       class="btn @(ViewBag.StatusFilter == "Matched" ? "btn-primary" : "btn-outline-primary")">
                        Matched (@Model.Count(i => i.Status == "Matched"))
                    </a>
                    <a asp-action="PendingPayments" asp-route-statusFilter="Resolved"
                       class="btn @(ViewBag.StatusFilter == "Resolved" ? "btn-primary" : "btn-outline-primary")">
                        Resolved (@Model.Count(i => i.Status == "Resolved"))
                    </a>
                    <a asp-action="PendingPayments" asp-route-statusFilter="Disputed"
                       class="btn @(ViewBag.StatusFilter == "Disputed" ? "btn-primary" : "btn-outline-primary")">
                        Disputed (@Model.Count(i => i.Status == "Disputed"))
                    </a>
                </div>
            </div>

            <!-- Search Bar -->
            <div class="mb-4">
                <div class="input-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by any field...">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Pending Payments Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="pendingTable">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice Info</th>
                            <th>Date</th>
                            <th>Amount (€)</th>
                            <th>Card PAN</th>
                            <th>ERPTID</th>
                            <th>Status</th>
                            <th>Added Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr data-id="@invoice.Id" class="@GetRowClass(invoice.Status)">
                                <td title="@invoice.RepeatedReason">@invoice.InvoiceInfo</td>
                                <td>@invoice.DateOnly</td>
                                <td>@invoice.ERPAmount.ToString("N2")</td>
                                <td>@invoice.CardPAN</td>
                                <td>@invoice.ERPTID</td>
                                <td>
                                    <span class="badge @GetBadgeClass(invoice.Status)">@invoice.Status</span>
                                </td>
                                <td>@invoice.AddedDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-info view-btn"
                                            data-bs-toggle="modal" data-bs-target="#detailsModal"
                                            data-id="@invoice.Id">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary update-btn"
                                            data-bs-toggle="modal" data-bs-target="#updateModal"
                                            data-id="@invoice.Id">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form asp-action="DeletePendingInvoice" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@invoice.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this pending payment?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-4">
                    <i class="fas fa-info-circle"></i> No pending payments found.
                </div>
            }
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Invoice Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsContent">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateInvoiceStatus" method="post">
                <div class="modal-body">
                    <input type="hidden" id="updateId" name="id" />
                    <div class="mb-3">
                        <label for="status" class="form-label">Status</label>
                        <select class="form-select" id="status" name="status">
                            <option value="Pending">Pending</option>
                            <option value="Matched">Matched</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Disputed">Disputed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes</label>
                        <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    string GetRowClass(string status)
    {
        return status switch
        {
            "Pending" => "",
            "Matched" => "table-success",
            "Resolved" => "table-info",
            "Disputed" => "table-warning",
            _ => ""
        };
    }

    string GetBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-secondary",
            "Matched" => "bg-success",
            "Resolved" => "bg-info",
            "Disputed" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#pendingTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Load invoice details into modal
            $('.view-btn').click(function () {
                var id = $(this).data('id');
                $.get('@Url.Action("GetInvoiceDetails", "Invoice")' + '?id=' + id, function (data) {
                    $('#detailsContent').html(data);
                });
            });

            // Set up update modal
            $('.update-btn').click(function () {
                var id = $(this).data('id');
                $('#updateId').val(id);

                // Reset form
                $('#status').val('Pending');
                $('#notes').val('');
            });
        });
    </script>
}