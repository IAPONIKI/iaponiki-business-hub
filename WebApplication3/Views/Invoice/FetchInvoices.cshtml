@model List<ServiceReference1.InvoiceData>

@{
    ViewBag.Title = "Compare Invoices";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-primary"><i class="fas fa-upload"></i> Upload Excel File & Fetch Invoices</h2>

        <!--Combined Date Selection & File Upload Form -->
        <form asp-action="UploadExcel" asp-controller="Home" method="post" enctype="multipart/form-data" class="mb-4">
            <div class="row">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date:</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" required>
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date:</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" required>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="input-group">
                        <input type="file" name="file" accept=".xlsx" class="form-control" required>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-sync"></i> Upload & Compare</button>
                    </div>
                </div>
            </div>
        </form>

        <div class="container mt-4">
            <a asp-action="DownloadMatchedInvoices" class="btn btn-success me-2">
                <i class="fas fa-file-excel"></i> Download Matched Invoices
            </a>
            <a asp-action="DownloadPendingInvoices" class="btn btn-warning">
                <i class="fas fa-file-excel"></i> Download Pending Invoices
            </a>
        </div>

    </div>
</div>

<!--Matching Invoices Section -->
@if (Model != null && Model.Any())
{
    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h3><i class="fas fa-check-circle"></i> Matching Invoices (@Model.Count)</h3>
                <button class="btn btn-light toggle-btn" data-bs-toggle="collapse" data-bs-target="#matchingInvoicesCard">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
            <div id="matchingInvoicesCard" class="collapse show">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover border">
                            <thead class="table-success">
                                <tr>
                                    <th>Invoice Info</th>
                                    <th>Repeated Reason</th>
                                    <th>Document ID</th>
                                    <th>Date</th>
                                    <th>Amount (€)</th>
                                    <th>Card PAN</th>
                                    <th>ERPTID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in Model)
                                {
                                    <tr>
                                        <td>@invoice.InvoiceInfo</td>
                                        <td>@invoice.RepeatedReason</td>
                                        <td>@invoice.InvoiceDocumentId</td>
                                        <td>@invoice.DateOnly</td>
                                        <td>@invoice.ERPAmount.ToString("N2")</td>
                                        <td>@invoice.CardPAN</td>
                                        <td>@invoice.ERPTID</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ❌ New Pending Invoices Section -->
@if (ViewBag.Differences != null && ((List<ServiceReference1.InvoiceData>)ViewBag.Differences).Any())
{
    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h3><i class="fas fa-exclamation-triangle"></i> New Pending Invoices (@(((List<ServiceReference1.InvoiceData>)ViewBag.Differences)?.Count ?? 0))</h3>
                <button class="btn btn-light toggle-btn" data-bs-toggle="collapse" data-bs-target="#pendingInvoicesCard">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
            <div id="pendingInvoicesCard" class="collapse show">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover border">
                            <thead class="table-warning">
                                <tr>
                                    <th>Invoice Info</th>
                                    <th>Repeated Reason</th>
                                    <th>Document ID</th>
                                    <th>Date</th>
                                    <th>Amount (€)</th>
                                    <th>Card PAN</th>
                                    <th>ERPTID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in (List<ServiceReference1.InvoiceData>)ViewBag.Differences)
                                {
                                    <tr class="table-warning">
                                        <td>@invoice.InvoiceInfo</td>
                                        <td>@invoice.RepeatedReason</td>
                                        <td>@invoice.InvoiceDocumentId</td>
                                        <td>@invoice.DateOnly</td>
                                        <td>@invoice.ERPAmount.ToString("N2")</td>
                                        <td>@invoice.CardPAN</td>
                                        <td>@invoice.ERPTID</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!--Cleared Pending Payments Section -->
@if (ViewBag.MatchedPendingInvoices != null && ((List<ServiceReference1.InvoiceData>)ViewBag.MatchedPendingInvoices).Any())
{
    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h3><i class="fas fa-check-circle"></i> Cleared Pending Payments (@((List<ServiceReference1.InvoiceData>)ViewBag.MatchedPendingInvoices).Count)</h3>
                <button class="btn btn-light toggle-btn" data-bs-toggle="collapse" data-bs-target="#clearedPendingCard">
                    <i class="fas fa-chevron-down"></i>
                </button>
            </div>
            <div id="clearedPendingCard" class="collapse show">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover border">
                            <thead class="table-info">
                                <tr>
                                    <th>Invoice Info</th>
                                    <th>Repeated Reason</th>
                                    <th>Document ID</th>
                                    <th>Date</th>
                                    <th>Amount (€)</th>
                                    <th>Card PAN</th>
                                    <th>ERPTID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in (List<ServiceReference1.InvoiceData>)ViewBag.MatchedPendingInvoices)
                                {
                                    <tr class="table-info">
                                        <td>@invoice.InvoiceInfo</td>
                                        <td>@invoice.RepeatedReason</td>
                                        <td>@invoice.InvoiceDocumentId</td>
                                        <td>@invoice.DateOnly</td>
                                        <td>@invoice.ERPAmount.ToString("N2")</td>
                                        <td>@invoice.CardPAN</td>
                                        <td>@invoice.ERPTID</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Bootstrap Icons & JS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".toggle-btn").forEach(function (button) {
            let targetId = button.getAttribute("data-bs-target"); // Get the target collapse ID
            let targetElement = document.querySelector(targetId);

            // Set initial icon based on collapse state
            button.querySelector("i").classList.toggle("fa-chevron-right", !targetElement.classList.contains("show"));

            // Add event listener to update icon on toggle
            targetElement.addEventListener("hidden.bs.collapse", function () {
                button.querySelector("i").classList.replace("fa-chevron-down", "fa-chevron-right");
            });

            targetElement.addEventListener("shown.bs.collapse", function () {
                button.querySelector("i").classList.replace("fa-chevron-right", "fa-chevron-down");
            });
        });
    });
</script>